// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USUARIO
  MEDICO
  ENFERMERA
  ADMINISTRATIVO
  ADMINISTRADOR
}

enum MedicalSpecialty {
  CLINICA_MEDICA
  PEDIATRIA
  TRAUMATOLOGIA
}

model User {
  id                    String    @id @default(cuid())
  clerkUserId           String    @unique
  email                 String    @unique
  firstName             String
  lastName              String
  docType               String    @default("DNI")
  docNumber             String    @unique
  birthDate             DateTime
  phone                 String
  address               String?
  alternativeContact    String?

  // Cobertura / Obra Social
  coverageType          String    @default("PARTICULAR") // "OBRA_SOCIAL" | "PARTICULAR"
  healthInsuranceEntity String?
  healthInsurancePlan   String?
  healthInsuranceNumber String?

  role                  Role      @default(USUARIO)
  specialty             MedicalSpecialty?
  isActive              Boolean   @default(true)
  deactivatedAt         DateTime?

  monthlyAvailabilities MonthlyAvailability[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model MonthlyAvailability {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  jornadas  AvailabilityJornada[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month])
}

model AvailabilityJornada {
  id                    String              @id @default(cuid())
  monthlyAvailabilityId String
  monthlyAvailability   MonthlyAvailability @relation(fields: [monthlyAvailabilityId], references: [id], onDelete: Cascade)
  date                  DateTime            @db.Date
  startTime             String
  endTime               String

  @@unique([monthlyAvailabilityId, date])
}
