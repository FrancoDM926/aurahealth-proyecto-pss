// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USUARIO
  MEDICO
  ENFERMERA
  ADMINISTRATIVO
  ADMINISTRADOR
}

enum MedicalSpecialty {
  CLINICA_MEDICA
  PEDIATRIA
  TRAUMATOLOGIA
}

model User {
  id                    String    @id @default(cuid())
  clerkUserId           String    @unique
  email                 String    @unique
  firstName             String
  lastName              String
  docType               String    @default("DNI")
  // Opcionales solo para usuarios internos: el administrador los crea sin
  // estos datos y cada uno los completa desde "Mi cuenta". El autorregistro
  // de pacientes (US-01) los sigue exigiendo.
  docNumber             String?   @unique
  birthDate             DateTime?
  phone                 String?
  address               String?
  alternativeContact    String?

  // Cobertura / Obra Social
  coverageType          String    @default("PARTICULAR") // "OBRA_SOCIAL" | "PARTICULAR"
  healthInsuranceEntity String?
  healthInsurancePlan   String?
  healthInsuranceNumber String?

  role                  Role      @default(USUARIO)
  specialty             MedicalSpecialty?
  isActive              Boolean   @default(true)
  deactivatedAt         DateTime?

  monthlyAvailabilities MonthlyAvailability[]
  turnos                Turno[]                 @relation("DoctorTurnos")
  turnosReservados      Turno[]                 @relation("ReservedTurnos")
  cambiosEstadoTurno    TurnoEstadoAuditLog[]   @relation("TurnoEstadoCambiadoPor")

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model MonthlyAvailability {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  isConfirmed Boolean  @default(false)
  confirmedAt DateTime?
  jornadas    AvailabilityJornada[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year, month])
}

model AvailabilityJornada {
  id                    String              @id @default(cuid())
  monthlyAvailabilityId String
  monthlyAvailability   MonthlyAvailability @relation(fields: [monthlyAvailabilityId], references: [id], onDelete: Cascade)
  date                  DateTime            @db.Date
  startTime             String
  endTime               String
  turnos                Turno[]

  @@unique([monthlyAvailabilityId, date])
}

enum EstadoTurno {
  DISPONIBLE
  RESERVADO
  CUMPLIDO
  AUSENTE
  CANCELADO
}

model Turno {
  id        String               @id @default(cuid())
  doctorId  String
  doctor    User                 @relation("DoctorTurnos", fields: [doctorId], references: [id], onDelete: Cascade)
  jornadaId String?
  jornada   AvailabilityJornada? @relation(fields: [jornadaId], references: [id], onDelete: SetNull)
  date      DateTime             @db.Date
  startTime String               // "HH:mm" (ej. "08:00")
  endTime   String               // "HH:mm" (ej. "08:30")
  duration  Int                  @default(30) // Fijo 30 minutos (RN-09)
  status    EstadoTurno          @default(DISPONIBLE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // Datos de reserva del paciente (US-13 / US-18). Nulos mientras está DISPONIBLE.
  reservedById     String?
  reservedBy       User?     @relation("ReservedTurnos", fields: [reservedById], references: [id], onDelete: SetNull)
  patientFirstName String?
  patientLastName  String?
  motivoConsulta   String?
  reservedAt       DateTime?

  // US-18 (RF-TUR-07): historial auditable de cambios de estado del turno.
  estadoAuditLogs  TurnoEstadoAuditLog[]

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date])
  @@index([status, date])
  @@index([reservedById])
}

/// US-18 (RF-TUR-07): Constancia auditable de quién cambió el estado de un turno y cuándo.
model TurnoEstadoAuditLog {
  id             String      @id @default(cuid())
  turnoId        String
  turno          Turno       @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  previousStatus EstadoTurno
  newStatus      EstadoTurno
  changedById    String
  changedBy      User        @relation("TurnoEstadoCambiadoPor", fields: [changedById], references: [id], onDelete: Restrict)
  changedByName  String
  changedByRole  Role
  changedAt      DateTime    @default(now())

  @@index([turnoId])
  @@index([changedAt])
}


/// Parámetros que el administrador ajusta sin tocar el código. Fila única (id = 1).
model Configuracion {
  id                Int      @id @default(1)
  // US-06 / RN-02: límites de jornadas por semana
  minJornadasSemana Int      @default(2)
  maxJornadasSemana Int      @default(7)
  updatedAt         DateTime @updatedAt
}

/// US-24 (RF-VAC-01, RN-05): catálogo de vacunas, única fuente de datos de vacunas del
/// sistema. No administra existencias: toda vacuna activa se asume con stock.
/// La unicidad "no hay dos vacunas ACTIVAS con la misma denominación y laboratorio"
/// la garantiza un índice único parcial creado en la migración
/// (Vacuna_denominacion_laboratorio_activa_key); Prisma no puede declararlo acá.
model Vacuna {
  id           String   @id @default(cuid())
  denominacion String
  laboratorio  String
  esquemaDosis String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, denominacion])
}
