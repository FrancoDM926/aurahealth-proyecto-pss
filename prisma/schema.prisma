// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USUARIO
  MEDICO
  ENFERMERA
  ADMINISTRATIVO
  ADMINISTRADOR
}

enum MedicalSpecialty {
  CLINICA_MEDICA
  PEDIATRIA
  TRAUMATOLOGIA
}

model User {
  id                 String    @id @default(cuid())
  clerkUserId        String    @unique
  email              String    @unique
  firstName          String
  lastName           String
  docType            String    @default("DNI")
  // Opcionales solo para usuarios internos: el administrador los crea sin
  // estos datos y cada uno los completa desde "Mi cuenta". El autorregistro
  // de pacientes (US-01) los sigue exigiendo.
  docNumber          String?   @unique
  birthDate          DateTime?
  phone              String?
  address            String?
  alternativeContact String?

  // Cobertura / Obra Social
  coverageType          String  @default("PARTICULAR") // "OBRA_SOCIAL" | "PARTICULAR"
  healthInsuranceEntity String?
  healthInsurancePlan   String?
  healthInsuranceNumber String?

  role          Role              @default(USUARIO)
  specialty     MedicalSpecialty?
  isActive      Boolean           @default(true)
  deactivatedAt DateTime?

  monthlyAvailabilities     MonthlyAvailability[]
  turnos                    Turno[]                      @relation("DoctorTurnos")
  turnosReservados          Turno[]                      @relation("ReservedTurnos")
  cambiosEstadoTurno        TurnoEstadoAuditLog[]        @relation("TurnoEstadoCambiadoPor")
  personasAtendidas         PersonaAtendida[]
  turnosCancelados          TurnoCancelacion[]
  preciosConsulta           PrecioConsulta[]             @relation("PrecioConsultaDoctor")
  pagosRegistrados          Pago[]                       @relation("PagoRegistradoPor")
  // Vacunatorio (US-63, US-28, US-29)
  jornadasVacunatorio       JornadaVacunatorio[]         @relation("JornadaVacunatorioCreador")
  turnosVacunacionTitular   TurnoVacunacion[]            @relation("TurnoVacunacionTitular")
  turnosVacunacionOtorgados TurnoVacunacion[]            @relation("TurnoVacunacionOtorgadoPor")
  cancelacionesVacunacion   TurnoVacunacionCancelacion[] @relation("VacunacionCancelaciones")
  aplicacionesRecibidas     AplicacionDosis[]            @relation("AplicacionPacienteUser")
  aplicacionesRegistradas   AplicacionDosis[]            @relation("AplicacionEnfermera")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonthlyAvailability {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  isConfirmed Boolean               @default(false)
  confirmedAt DateTime?
  jornadas    AvailabilityJornada[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([userId, year, month])
}

model AvailabilityJornada {
  id                    String              @id @default(cuid())
  monthlyAvailabilityId String
  monthlyAvailability   MonthlyAvailability @relation(fields: [monthlyAvailabilityId], references: [id], onDelete: Cascade)
  date                  DateTime            @db.Date
  startTime             String
  endTime               String
  turnos                Turno[]

  @@unique([monthlyAvailabilityId, date])
}

enum EstadoTurno {
  DISPONIBLE
  RESERVADO
  CUMPLIDO
  AUSENTE
  CANCELADO
}

/// US-15: estado del recordatorio automático del turno. Funciona como candado de
/// idempotencia: mientras está PENDIENTE el proceso puede reclamarlo; una vez
/// ENVIADO no se vuelve a enviar aunque el proceso se reintente.
enum EstadoRecordatorio {
  PENDIENTE
  ENVIADO
}

model Turno {
  id        String               @id @default(cuid())
  doctorId  String
  doctor    User                 @relation("DoctorTurnos", fields: [doctorId], references: [id], onDelete: Cascade)
  jornadaId String?
  jornada   AvailabilityJornada? @relation(fields: [jornadaId], references: [id], onDelete: SetNull)
  date      DateTime             @db.Date
  startTime String // "HH:mm" (ej. "08:00")
  endTime   String // "HH:mm" (ej. "08:30")
  duration  Int                  @default(30) // Fijo 30 minutos (RN-09)
  status    EstadoTurno          @default(DISPONIBLE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // US-13: datos de la reserva. Nulos mientras está DISPONIBLE.
  reservedById      String?
  reservedBy        User?            @relation("ReservedTurnos", fields: [reservedById], references: [id], onDelete: SetNull)
  // US-64: persona atendida cuando el turno es a nombre de otra persona. El
  // nombre se copia en patientFirstName/patientLastName para que lo lean
  // US-14, US-18 y la agenda sin otra consulta.
  personaAtendidaId String?
  personaAtendida   PersonaAtendida? @relation(fields: [personaAtendidaId], references: [id], onDelete: SetNull)
  patientFirstName  String?
  patientLastName   String?
  motivoConsulta    String?
  reservedAt        DateTime?

  // US-15: recordatorio automático del turno (RF-TUR-04, RF-NOT-01).
  recordatorioEstado      EstadoRecordatorio @default(PENDIENTE)
  recordatorioEnviadoAt   DateTime?
  recordatorioIntentos    Int                @default(0)
  recordatorioUltimoError String?
  /**
   * Id del registro en EmailAuditLog que dejó el envío (US-21).
   */
  recordatorioEmailLogId  String?

  // US-18 (RF-TUR-07): historial auditable de cambios de estado del turno.
  estadoAuditLogs TurnoEstadoAuditLog[]
  cancelaciones   TurnoCancelacion[]
  // US-35: pago de la consulta (un único pago ACTIVO por turno cumplido).
  pagos           Pago[]

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date])
  @@index([status, date])
  @@index([reservedById])
  @@index([recordatorioEstado, date])
}

/// US-64: persona a cuyo nombre un usuario reservó un turno, con su cobertura.
/// Queda guardada para elegirla en reservas posteriores sin reingresar sus datos.
model PersonaAtendida {
  id                    String            @id @default(cuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  docNumber             String
  birthDate             DateTime          @db.Date
  healthInsuranceEntity String
  healthInsurancePlan   String
  healthInsuranceNumber String
  turnos                Turno[]
  turnosVacunacion      TurnoVacunacion[]
  aplicaciones          AplicacionDosis[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([userId, docNumber])
}

/// US-16: constancia de un turno cancelado por el paciente. El turno vuelve a
/// DISPONIBLE para que otro lo reserve; la cancelación queda en este historial
/// (no se elimina) con los datos de la reserva tal como estaban.
model TurnoCancelacion {
  id               String   @id @default(cuid())
  turnoId          String?
  turno            Turno?   @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  reservedById     String
  reservedBy       User     @relation(fields: [reservedById], references: [id], onDelete: Cascade)
  doctorNombre     String
  date             DateTime @db.Date
  startTime        String
  endTime          String
  patientFirstName String?
  patientLastName  String?
  cancelledAt      DateTime @default(now())

  @@index([reservedById])
}

/// US-18 (RF-TUR-07): Constancia auditable de quién cambió el estado de un turno y cuándo.
model TurnoEstadoAuditLog {
  id             String      @id @default(cuid())
  turnoId        String
  turno          Turno       @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  previousStatus EstadoTurno
  newStatus      EstadoTurno
  changedById    String
  changedBy      User        @relation("TurnoEstadoCambiadoPor", fields: [changedById], references: [id], onDelete: Restrict)
  changedByName  String
  changedByRole  Role
  changedAt      DateTime    @default(now())

  @@index([turnoId])
  @@index([changedAt])
}

/// Parámetros que el administrador ajusta sin tocar el código. Fila única (id = 1).
model Configuracion {
  id                          Int      @id @default(1)
  // US-06 / RN-02: límites de jornadas por semana
  minJornadasSemana           Int      @default(2)
  maxJornadasSemana           Int      @default(7)
  // US-14: dirección de la sala que se informa en el email de confirmación de turno.
  salaDireccion               String?
  // US-15: antelación del recordatorio de turno, en horas (inicial 24).
  recordatorioAntelacionHoras Int      @default(24)
  // US-21: envíos fallidos que puede acumular un mismo destinatario antes de
  // que el servicio deje de reintentarle (pantalla "Emails", valor inicial 3).
  maxEnviosFallidosPorUsuario Int      @default(3)
  // US-16: antelación mínima para que el paciente cancele un turno, en horas (inicial 24).
  cancelacionAntelacionHoras  Int      @default(24)
  updatedAt                   DateTime @updatedAt
}

/// US-21: cuerpo editable de una plantilla de email (wireframe
/// wf_servicio_email.html). Solo se edita el mensaje: el asunto, el remitente y
/// los destinatarios son fijos por plantilla. Sin fila, rige el mensaje por
/// defecto definido en el catálogo del servicio.
model PlantillaEmail {
  clave     String   @id // NotificationTemplateType administrable
  mensaje   String
  updatedAt DateTime @updatedAt
}

/// US-24 (RF-VAC-01, RN-05): catálogo de vacunas, única fuente de datos de vacunas del
/// sistema. No administra existencias: toda vacuna activa se asume con stock.
/// La unicidad "no hay dos vacunas ACTIVAS con la misma denominación y laboratorio"
/// la garantiza un índice único parcial creado en la migración
/// (Vacuna_denominacion_laboratorio_activa_key); Prisma no puede declararlo acá.
model Vacuna {
  id           String   @id @default(cuid())
  denominacion String
  laboratorio  String
  esquemaDosis String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Esquema estructurado (RF-VAC-06, RF-VAC-08). `esquemaDosis` queda como texto descriptivo.
  dosis            VacunaDosis[]
  turnosVacunacion TurnoVacunacion[]
  aplicaciones     AplicacionDosis[]

  @@index([isActive, denominacion])
}

/// US-34 (RN-14): obra social con su descuento porcentual predefinido, que se aplica
/// sobre el precio de consulta sin cobertura del médico. Lo administra el
/// administrador desde Configuración. Una entidad sin fila (o paciente particular)
/// no recibe descuento.
model ObraSocial {
  id                  String   @id @default(cuid())
  nombre              String   @unique
  /// Entero de 0 a 100.
  descuentoPorcentaje Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// US-33 (RF-PAG-02): precio de la consulta SIN cobertura que define cada médico.
/// Rige desde `vigenteDesde`; las filas anteriores forman el historial de vigencias
/// y nunca se pisan ni se borran. El precio vigente a una fecha es la fila más
/// reciente con `vigenteDesde` menor o igual a esa fecha. Importe en centavos.
model PrecioConsulta {
  id            String   @id @default(cuid())
  doctorId      String
  doctor        User     @relation("PrecioConsultaDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  montoCentavos Int
  vigenteDesde  DateTime @db.Date
  createdAt     DateTime @default(now())

  @@unique([doctorId, vigenteDesde])
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
}

enum EstadoPago {
  ACTIVO
  ANULADO
}

/// US-35 / US-36 (RF-PAG-04, RF-PAG-05): pago de una consulta cumplida. Guarda una
/// copia de los valores aplicados al momento del cobro (precio, cobertura, descuento
/// y datos del comprobante) para que cambios posteriores de precio o de cobertura
/// no los alteren.
/// La regla "un turno no tiene dos pagos ACTIVOS" la garantiza un índice único
/// parcial creado en la migración (Pago_turnoId_activo_key); Prisma no puede
/// declararlo acá.
model Pago {
  id         String     @id @default(cuid())
  turnoId    String
  turno      Turno      @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  estado     EstadoPago @default(ACTIVO)
  medio      MedioPago
  /// Referencia de la operación (solo transferencia).
  referencia String?

  // Importe aplicado (US-34), en centavos.
  precioSinCoberturaCentavos Int
  precioVigenteDesde         DateTime @db.Date
  /// Entidad de la obra social aplicada; nulo = paciente particular.
  coberturaEntidad           String?
  descuentoPorcentaje        Int
  descuentoCentavos          Int
  importeCentavos            Int

  // Comprobante (US-36).
  /// Numeración correlativa, sin huecos ni duplicados (ver ComprobanteContador).
  comprobanteNumero Int     @unique
  pacienteNombre    String
  pacienteDocumento String?
  prestacion        String
  profesionalNombre String

  registradoPorId     String
  registradoPor       User     @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  registradoPorNombre String
  createdAt           DateTime @default(now())

  // Anulación (US-61, fuera de alcance de este sprint): el reporte de pagos (US-47)
  // ya distingue los anulados.
  anuladoAt     DateTime?
  anuladoMotivo String?

  @@index([createdAt])
  @@index([turnoId])
}

/// US-36: contador de la numeración de comprobantes. Fila única (id = 1). Se
/// incrementa dentro de la misma transacción que crea el pago: el bloqueo de fila
/// serializa los cobros concurrentes y, si la transacción falla, el número no se
/// consume (sin huecos ni duplicados).
model ComprobanteContador {
  id     Int @id @default(1)
  ultimo Int @default(0)
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/// Registro auditable de notificaciones por email (US-21 / RF-NOT-01)
model EmailAuditLog {
  id        String      @id @default(cuid())
  recipient String
  template  String
  subject   String
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([recipient])
  @@index([status])
  @@index([template])
  @@index([createdAt])
}

/// US-24 (ampliación) / US-29 / US-57: dosis estructuradas del esquema de una vacuna.
/// Permite elegir la dosis al aplicarla, evaluar si el esquema quedó incompleto y
/// calcular desde cuándo corresponde la siguiente. `diasDesdeAnterior` es nulo en la
/// primera dosis; en las demás es el intervalo mínimo respecto de la dosis previa.
model VacunaDosis {
  id                String @id @default(cuid())
  vacunaId          String
  vacuna            Vacuna @relation(fields: [vacunaId], references: [id], onDelete: Cascade)
  orden             Int
  etiqueta          String
  diasDesdeAnterior Int?

  @@unique([vacunaId, orden])
}

/// US-63 (RF-VAC-09, RN-08): franja de atención del vacunatorio. La agenda es única y
/// compartida por las enfermeras (sin dueño individual) e independiente de las agendas
/// médicas. Varias franjas por día, sin solaparse. No aplica la regla de 2 a 7 jornadas.
model JornadaVacunatorio {
  id          String            @id @default(cuid())
  date        DateTime          @db.Date
  startTime   String
  endTime     String
  createdById String
  createdBy   User              @relation("JornadaVacunatorioCreador", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
  turnos      TurnoVacunacion[]

  @@index([date])
}

/// US-63 / US-28: turno de 30 minutos de la agenda del vacunatorio. Un turno por horario.
model TurnoVacunacion {
  id        String              @id @default(cuid())
  jornadaId String?
  jornada   JornadaVacunatorio? @relation(fields: [jornadaId], references: [id], onDelete: SetNull)
  date      DateTime            @db.Date
  startTime String
  endTime   String
  duration  Int                 @default(30)
  status    EstadoTurno         @default(DISPONIBLE)

  vacunaId           String?
  vacuna             Vacuna?          @relation(fields: [vacunaId], references: [id], onDelete: Restrict)
  /// Dosis que se prevé aplicar (informativa; la real se fija en US-29).
  dosisPrevistaOrden Int?
  /// Titular: usuario registrado que recibe los emails.
  reservedById       String?
  reservedBy         User?            @relation("TurnoVacunacionTitular", fields: [reservedById], references: [id], onDelete: SetNull)
  /// Empleado de mostrador que otorgó el turno (nulo si lo sacó el propio usuario).
  otorgadoPorId      String?
  otorgadoPor        User?            @relation("TurnoVacunacionOtorgadoPor", fields: [otorgadoPorId], references: [id], onDelete: SetNull)
  personaAtendidaId  String?
  personaAtendida    PersonaAtendida? @relation(fields: [personaAtendidaId], references: [id], onDelete: SetNull)
  patientFirstName   String?
  patientLastName    String?
  reservedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  aplicaciones  AplicacionDosis[]
  cancelaciones TurnoVacunacionCancelacion[]

  @@unique([date, startTime])
  @@index([status, date])
  @@index([reservedById])
}

/// Constancia de un turno de vacunación cancelado (no se elimina). Análoga a TurnoCancelacion.
model TurnoVacunacionCancelacion {
  id               String           @id @default(cuid())
  turnoId          String?
  turno            TurnoVacunacion? @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  reservedById     String
  reservedBy       User             @relation("VacunacionCancelaciones", fields: [reservedById], references: [id], onDelete: Cascade)
  vacunaNombre     String?
  date             DateTime         @db.Date
  startTime        String
  endTime          String
  patientFirstName String?
  patientLastName  String?
  canceladoPorId   String?
  cancelledAt      DateTime         @default(now())

  @@index([reservedById])
}

enum EstadoAplicacion {
  ACTIVA
  ANULADA
}

/// US-29 (RF-VAC-06, RNF-04): registro sanitario de una dosis aplicada. Inmutable: nunca
/// se elimina; una corrección es una anulación con motivo. Referencia exactamente uno de
/// `pacienteUserId` / `personaAtendidaId` (CHECK en la migración). Los índices únicos
/// parciales (migración) impiden dos aplicaciones ACTIVAS de la misma dosis a la misma
/// persona y dos activas para el mismo turno.
model AplicacionDosis {
  id                String           @id @default(cuid())
  pacienteUserId    String?
  pacienteUser      User?            @relation("AplicacionPacienteUser", fields: [pacienteUserId], references: [id], onDelete: Restrict)
  personaAtendidaId String?
  personaAtendida   PersonaAtendida? @relation(fields: [personaAtendidaId], references: [id], onDelete: Restrict)
  pacienteNombre    String
  pacienteDocumento String?
  vacunaId          String
  vacuna            Vacuna           @relation(fields: [vacunaId], references: [id], onDelete: Restrict)
  vacunaNombre      String
  dosisOrden        Int
  dosisEtiqueta     String
  aplicadaAt        DateTime         @default(now())
  enfermeraId       String
  enfermera         User             @relation("AplicacionEnfermera", fields: [enfermeraId], references: [id], onDelete: Restrict)
  enfermeraNombre   String
  turnoVacunacionId String?
  turnoVacunacion   TurnoVacunacion? @relation(fields: [turnoVacunacionId], references: [id], onDelete: SetNull)
  estado            EstadoAplicacion @default(ACTIVA)
  anuladaAt         DateTime?
  anuladaMotivo     String?
  anuladaPorId      String?
  anuladaPorNombre  String?
  createdAt         DateTime         @default(now())

  @@index([pacienteUserId, vacunaId])
  @@index([personaAtendidaId, vacunaId])
  @@index([aplicadaAt])
}
